                <label asp-for="ClientProfile.Contact" class="control-label"></label>
                <input asp-for="ClientProfile.Contact" class="form-control" />
                <span asp-validation-for="ClientProfile.Contact" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

