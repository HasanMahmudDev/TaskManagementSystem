@page
@model TaskManagementSystem.Web.Pages_ClientProfiles.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>ClientProfile</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ClientProfile.UserId" class="control-label"></label>
                <select asp-for="ClientProfile.UserId" class ="form-control" asp-items="ViewBag.UserId" ></select>
