@using System.Security.Claims
@using System.Text.Json
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentPath = Context.Request.Path.Value ?? string.Empty;

    bool IsActive(params string[] prefixes)
    {
        foreach (var prefix in prefixes)
        {
            if (currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Task Management</title>
    <link rel="stylesheet" href="~/adminhmd/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/adminhmd/vendors/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/adminhmd/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskManagementSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
@if (isAuthenticated)
{
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
    var canManageProjects = isAdmin || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase);
    var canUpdateTasks = canManageProjects || string.Equals(role, "Employee", StringComparison.OrdinalIgnoreCase);
    var canViewTasks = canUpdateTasks || string.Equals(role, "Client", StringComparison.OrdinalIgnoreCase);
    var canViewClientProfiles = isAdmin || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase) || string.Equals(role, "Client", StringComparison.OrdinalIgnoreCase);
    var userName = User.Identity?.Name ?? "Workspace User";
    var roleLabel = string.IsNullOrWhiteSpace(role) ? "Workspace Member" : role;
    var avatarPath = Url.Content("~/adminhmd/images/avatar/avatar.jpg");

    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
            <div class="sidebar-header">
                <a class="brand-mark" asp-page="/Dashboard" aria-label="Task management dashboard">
                    <span class="brand-icon"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i></span>
                    <span class="brand-copy">
                        <span class="brand-title">Task Manager</span>
                        <span class="brand-subtitle">adminHMD UI</span>
                    </span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @((IsActive("/Dashboard", "/Index") || string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty)" asp-page="/Dashboard">
                    <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>

                @if (isAdmin)
                {
                    <a class="nav-link @(IsActive("/Users") ? "active" : string.Empty)" asp-page="/Users/Index">
                        <span class="nav-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                        <span class="nav-text">Users</span>
                    </a>
                    <a class="nav-link @(IsActive("/Roles") ? "active" : string.Empty)" asp-page="/Roles/Index">
                        <span class="nav-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                        <span class="nav-text">Roles</span>
                    </a>
                    <a class="nav-link @(IsActive("/AppPages") ? "active" : string.Empty)" asp-page="/AppPages/Index">
                        <span class="nav-icon"><i class="bi bi-window-sidebar" aria-hidden="true"></i></span>
                        <span class="nav-text">App Pages</span>
                    </a>
                    <a class="nav-link @(IsActive("/RolePermissions") ? "active" : string.Empty)" asp-page="/RolePermissions/Index">
                        <span class="nav-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                        <span class="nav-text">Role Permissions</span>
                    </a>
                }

                @if (canViewClientProfiles)
                {
                    <a class="nav-link @(IsActive("/ClientProfiles") ? "active" : string.Empty)" asp-page="/ClientProfiles/Index">
                        <span class="nav-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
                        <span class="nav-text">Client Profiles</span>
                    </a>
                }

                @if (canManageProjects)
                {
                    <a class="nav-link @(IsActive("/Categories") ? "active" : string.Empty)" asp-page="/Categories/Index">
                        <span class="nav-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                        <span class="nav-text">Categories</span>
                    </a>
                }

                @if (canViewTasks)
                {
                    <a class="nav-link @(IsActive("/Tasks") ? "active" : string.Empty)" asp-page="/Tasks/Index">
                        <span class="nav-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                        <span class="nav-text">Tasks</span>
                    </a>
                }

                @if (canUpdateTasks)
                {
                    <a class="nav-link @(IsActive("/TaskUpdates") ? "active" : string.Empty)" asp-page="/TaskUpdates/Index">
                        <span class="nav-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
                        <span class="nav-text">Task Updates</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <a class="nav-link @(IsActive("/Permissions") ? "active" : string.Empty)" asp-page="/Permissions/Index">
                        <span class="nav-icon"><i class="bi bi-key" aria-hidden="true"></i></span>
                        <span class="nav-text">Permissions</span>
                    </a>
                }
            </nav>

            <div class="sidebar-user">
                <img class="avatar-img avatar-md sidebar-user-avatar" src="@avatarPath" alt="@userName" />
                <strong>@userName</strong>
                <small>@roleLabel</small>
            </div>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span class="sidebar-footer-text">Workspace connected</span>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <div class="ms-3 d-none d-md-block">
                        <p class="eyebrow mb-1">Task Management</p>
                        <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                    </div>

                    <div class="navbar-actions ms-auto">
                        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
                            <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                        </button>

                        <div class="dropdown">
                            <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img class="avatar-img avatar-sm" src="@avatarPath" alt="@userName" />
                                <span class="profile-name d-none d-sm-inline">@userName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text small text-muted">Signed in as @userName</span></li>
                                <li><span class="dropdown-item-text">@roleLabel</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout" class="px-3 pb-2">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="dashboard-content">
                <div class="container-fluid px-3 px-lg-4 py-4">
                    @RenderBody()
                </div>
            </main>

            <footer class="admin-footer">
                <div class="container-fluid px-3 px-lg-4">
                    <span>Task Management System</span>
                    <span>@DateTime.UtcNow.Year - adminHMD powered interface</span>
                </div>
            </footer>
        </div>
    </div>

    <script>
        window.adminHMDUser = {
            name: @Html.Raw(JsonSerializer.Serialize(userName)),
            workspace: @Html.Raw(JsonSerializer.Serialize(roleLabel)),
            avatar: @Html.Raw(JsonSerializer.Serialize(avatarPath))
        };
    </script>
}
else
{
    <main class="auth-page">
        <div class="container">
            @RenderBody()
        </div>
    </main>
}

    <script src="~/adminhmd/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
@if (isAuthenticated)
{
    <script src="~/adminhmd/js/main.js" asp-append-version="true"></script>
}
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
