@page
@model TaskManagementSystem.Web.Pages_TaskUpdates.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TaskUpdate[0].UpdateInfo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskUpdate[0].UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskUpdate[0].Task)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskUpdate[0].UpdatedByUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.TaskUpdate) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UpdateInfo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Task.TaskName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedByUser.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.UpdateId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.UpdateId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.UpdateId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
